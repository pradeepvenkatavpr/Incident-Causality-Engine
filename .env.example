APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=json
WEB_CONCURRENCY=1

API_PORT=8000
API_MEMORY_LIMIT=1g
API_CPU_LIMIT=1.5

GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=ChangeThisToAStrongUniquePassword123!
GRAFANA_ROOT_URL=http://localhost:3000
GRAFANA_MEMORY_LIMIT=384m
GRAFANA_CPU_LIMIT=0.5

PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d
PROMETHEUS_RETENTION_SIZE=5GB
PROMETHEUS_MEMORY_LIMIT=512m
PROMETHEUS_CPU_LIMIT=0.75

LOKI_PORT=3100
LOKI_MEMORY_LIMIT=512m
LOKI_CPU_LIMIT=0.75

OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_MEMORY_LIMIT=256m
OTEL_CPU_LIMIT=0.5

REDIS_MAX_MEMORY=128mb
REDIS_MEMORY_LIMIT=192m
REDIS_CPU_LIMIT=0.25

DATA_DIR=/app/data
LOG_DIR=/app/logs
ARTIFACT_DIR=/app/artifacts

LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=

DATABASE_URL=
REDIS_URL=redis://redis:6379/0
PROMETHEUS_URL=http://prometheus:9090
LOKI_URL=http://loki:3100
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=ai-devops-causality-api

ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000